# Cấu hình biến môi trường cho dự án HTKhaoThi
# Sao chép file này thành .env và điền các giá trị bảo mật

# Khóa bí mật Django (Trong production: tạo khóa ngẫu nhiên an toàn)
SECRET_KEY=your_secret_key_here

# Chế độ gỡ lỗi (True khi dev, False khi deploy)
DEBUG=True

# Danh sách domain/IP được phép truy cập (phân tách bằng dấu phẩy)
ALLOWED_HOSTS=*

# Điền khóa Groq API vào đây để kích hoạt tính năng AI trích xuất câu hỏi và gợi ý
# Đăng ký lấy API key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
